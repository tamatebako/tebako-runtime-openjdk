#!/usr/bin/env ruby
# frozen_string_literal: true

# monitor — the release monitor's executable edge: check every flavor's
# upstream for a newer release ON THE PINNED LINE, rewrite the recipe's
# own pin literals when one resolves, and print the verdict as one JSON
# object on stdout (the workflow's PR title/body and the job summary read
# it). All logic lives in ReleaseMonitor (tools/lib/release_monitor.rb),
# which is specable without a network (spec/release_monitor_spec.rb).
#
#   ruby tools/monitor                  check upstream and rewrite Tebakofile
#   ruby tools/monitor --dry-run        the same check, printing the verdict
#                                       and writing nothing
#   ruby tools/monitor --pr-body <json> render a printed verdict as the PR body
#   ruby tools/monitor --self-test      run the offline cases this module
#                                       carries (openjdk's live in spec/)
#
# GH_TOKEN / GITHUB_TOKEN authenticate the api.github.com calls (a quota
# answer is retried, then named). Failures print one JSON object on stderr
# — a NAMED FAILURE message — and exit 1; a usage error exits 64.

$LOAD_PATH.unshift(File.expand_path("lib", __dir__))
require "release_monitor"

require "json"

def usage_failure(message)
  warn JSON.generate(action: "error", message: "NAMED FAILURE: #{message}")
  exit 64
end

args = ARGV.dup
pr_body_file = nil
if (index = args.index("--pr-body"))
  pr_body_file = args[index + 1] or usage_failure("--pr-body needs a verdict file")
  args.slice!(index, 2)
end
dry_run = !args.delete("--dry-run").nil?
self_test = !args.delete("--self-test").nil?
usage_failure("unknown argument(s): #{args.join(' ')}") unless args.empty?

if pr_body_file
  print ReleaseMonitor.pr_body(JSON.parse(File.read(pr_body_file)))
  exit 0
end

if self_test
  unless ReleaseMonitor.respond_to?(:self_test)
    usage_failure("--self-test is not wired in this repo (its offline cases live in spec/)")
  end
  exit(ReleaseMonitor.self_test ? 0 : 1)
end

begin
  puts JSON.generate(ReleaseMonitor.check(dry_run: dry_run))
rescue ReleaseMonitor::MonitorError => e
  warn JSON.generate(action: "error", message: e.message)
  exit 1
rescue SystemCallError => e
  warn JSON.generate(action: "error", message: "NAMED FAILURE: #{e.message}")
  exit 1
end
