build:
  system: repack          # no compilation: unpack, prune, image
  deps: []

# The runtime contract (spec 28 revised §8 + spec 29). tools/build renders
# manifests/runtime.yaml (tier-1, embedded at /__tpkg__/manifest.yaml) and
# manifests/layout.yaml (the driver pair contract, /lib/tebako/layout.yaml)
# from this block + the selected flavor's block — the feedstock's SSOT for
# the pair's declared identity. The per-flavor keys (implementation,
# language_version, abi_line, interpreter_api_version, entrypoints) live
# under flavors:<flavor>; the keys here are shared by both flavors.
runtime:
  engine: "java"
  contract_version: 2              # the spec 17 driver contract the wrapper speaks
  interpreter: "/bin/java"         # the wrapper's interpreter grant (layout schema_minor 4)
  # The per-flavor entrypoints list (flavors:<flavor>.entrypoints) is the
  # feedstock SSOT for the spawn surface (spec 30 §2): tools/build renders
  # it into the env image manifest's runtime entrypoints, the driver's
  # bare-name --tebako-entry resolves against exactly these declarations,
  # and the read-back + smoke gates prove them.
  visibility: "exec-cache"         # spec 29 §3: a JVM needs no VFS once its home is materialized; universal across triplets
  mount_root_override: false       # closed default — nothing in the JVM follows TEBAKO_MOUNT_ROOT; granting a no-op knob violates spec 00 §9
  # The tebako product line the pair builds against: the wrapper exe
  # (tebako-runtime-launcher) and the preload shim (link-unit). The line
  # number names the artifacts (tebako-runtime-<line>-<impl>-21.0.12-*
  # since tebako#716 — the flavor's implementation segment) and the
  # release tag (v<line> — the trr convention: the tag IS the tebako
  # line; distinct from the toolkit-era payload tags like 21.0.12-2).
  #
  # v2.1.0 (2026-09-01) is the first product release shipping
  # tebako-runtime-launcher on all 7 platforms (tamatebako/tebako#498,
  # spec 30). The local dogfood built the wrapper from
  # tamatebako/tebako@d61ccc50 (workspace version 2.0.0).
  # v2.1.3 (2026-09-02, tebako#515): the wrapper's preload shim
  # interposes the realpath family + gates the vfork-child pid — the
  # linux-gnu jing ClassNotFound class (usrmerge /lib→usr/lib leak into
  # the JDK's -jar/-cp canonicalization).
  # v2.1.4 (2026-09-02, tebako#516): the realpath NULL-buffer arm's
  # host pass-through routes to canonicalize_file_name on linux —
  # plain dlsym lands on the realpath@GLIBC_2.0 compat twin on
  # glibc ≤ 2.31, which EINVALs the NULL arm and broke jailed spawns
  # (exit 78) on the 0.16.19 factory floor.
  # v2.1.5 (2026-09-02, tebako#517): the NULL-arm reroute is
  # glibc-scoped — musl has no canonicalize_file_name at all, so the
  # v2.1.4 musl unit's constructor panicked on the RTLD_NEXT lookup
  # (all 44 musl legs of the first 0.16.19 re-cut). musl keeps the
  # plain-dlsym arm (no symbol versioning → no compat twin).
  # v2.3.0 (2026-09-05, tebako#538): spec 29 (the runtime-as-wrapper
  # pattern this pair is built on) flips PLANNED → SHIPPED. No wrapper
  # code change — the pin moves to the first line where the contract
  # the pair speaks is a shipped contract, not a draft.
  # v2.4.0 (2026-09-06): REQUIRED, not hygiene. The launcher's embedded
  # tpkg model must read spec 32's `kind: executable` requires edge
  # (shipped in tebako v2.2.0): metanorma 1.16.9-9 declares that edge
  # (xml2rfc spawn) and the 2.3.0 launcher's manifest parse refuses it
  # by the evolution law ("Jing failed … unknown variant `executable`"
  # on the 2026-09-06 bench's v2-shim cells). 2.4.0 is the current line
  # (enterprise networking, TODO.v2-1/33).
  # v2.5.0 (2026-09-07): REQUIRED, not hygiene, for spec 33 — the
  # on_runtime composition (TODO.truffleruby/03 + TODO.jruby/02 make this
  # pair the OWNER of a composed process). Spec 33 §1 amends entry
  # resolution: --tebako-entry resolves against the first image mount
  # whose manifest is NOT the depending runtime's env image; the 2.4.0
  # launcher predates that rule and joins the entry onto the depending
  # runtime's mount (the local jvm-leg composed smoke: "entrypoint
  # '/app/bin/hello' not found at '/__runners__/truffleruby/app/bin/hello'"
  # — green only once the owner exe was the 2.5.0 launcher). BOTH flavors
  # reline: graalvm is truffleruby-jvm's owner edge, temurin is jruby's.
  # v2.7.0 (2026-09-12): REQUIRED reline. The v2.5.1 tag re-published the
  # 2.5.0 line with signing but left wrapper_tebako at 2.5.0 — breaking
  # this repo's own rule that the tag IS the line: composed-name fetches
  # (the spawned-runtime {base}/v<line>/<asset> path) 404'd on
  # tebako-runtime-2.5.1-* (metanorma 1.16.9-11 publish, run 34683540428).
  # The line moves to the current signed product release and the publish
  # gains a tag==line guard so the mismatch can never publish again.
  # v2.8.21 (2026-09-28): the launcher's driver raises the limnifs
  # inline-metadata ceiling to 64 MiB (large-metadata payload images
  # mount inlined) and speaks the payload min_runtime_tebako floor
  # (tebako#666) — floored payloads skip stale cached runtimes at
  # resolution instead of failing at mount.
  # v2.8.23 (2026-09-29): the launcher's driver routes spawn arguments
  # by HELD mounts, not lexical coverage — absolute host paths under a
  # root-mounted payload pass through to the child (tebako#692/#693,
  # the metanorma-docker xml2rfc spawn class) — and the tpkg trailer
  # locator's PE arm boots Authenticode-signed stitched exes
  # (tebako#689). v2.8.22 (press support for ruby 4.0.7) touched no
  # driver code this pair consumes, so the line skips it. First tag
  # carrying the aarch64-linux-gnu legs (#54).
  # v2.8.28 (2026-10-12): the composition spectrum line — the driver's
  # virtual cwd (tebako#734), the $0/PROGRAM_NAME handoff (tebako#237),
  # and the alias-union dedupe (tebako#486) ride this pair's wrapper.
  # v2.8.24–v2.8.27 touched no driver code this pair consumes, so the
  # line skips them. First tag carrying the temurin musl pairs (#60).
  # v2.8.47 (2026-10-20): the preload boot bridges its entry token to
  # the host twin (tebako#831) — the wrapper runtimes' script-entry
  # leaks close with this line. First tag carrying the
  # windows-ucrt-arm64 launcher (#830) — the pair's win-arm64 leg is a
  # follow-up, not this roll.
  wrapper_tebako: "2.8.47"
  # The wrapper's trust anchor, per tool-platform (the launcher is the
  # shipped runtime pair's process entry point — an unauthenticated
  # download would be a supply-chain hole). Digests are the v2.8.47
  # release's own asset digests (fetched 2026-10-20).
  # release's monolith SHA256SUMS entries (fetched 2026-10-12).
  wrapper_sha256:
    macos-arm64: "eeee3f7bff1f7b8bd3b17e624ab5856c4fb5d8edb446f79ab962b44bd5651704"
    linux-gnu-x86_64: "7829d1a1f221aeca7bd79be40ebf3999563cbcff436f961b40bc08772ff06d1b"
    linux-gnu-arm64: "6083e904f26feb3c3082ecdafa34e48c483772a44ddf98db06571fd2a0a0878c"
    linux-musl-x86_64: "eca258757ae3a3d1b88a8e9163978e43b58686c08ddcdc13434523efbacc7cae"
    linux-musl-arm64: "ca8fedb94cf6ec30cb001a7ace1c0437932cec858021afa3ad290784780609fd"
    windows-ucrt64: "4b65e5ae8da9035ece328a7ec308c5f6d567782aa69740169e2c735b071777a1"

