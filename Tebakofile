# Feedstock recipe for openjdk
# spec 13 §9 + docs/conventions.md in tebako-packages/index
name: "openjdk"
kind: runtime
summary: "OpenJDK (Temurin JRE / GraalVM Community JDK) — tebako java RUNTIME pairs (wrapper exe + env image); the hermetic java for metanorma's jing/mn2pdf chain and truffleruby-jvm"

# The spec 28 §8 implementation axis: ONE recipe, flavored sources.
# temurin is the DEFAULT flavor — every default resolution channel (the
# registry's default row, config pins, the press lock) points here, and an
# edge omitting `implementation` lands temurin on a fresh store. graalvm
# serves `java:graalvm` selectors (TODO.truffleruby/03's jvm-mode runtime
# declares DEPENDS java:graalvm >= 24 — graalvm is never the default pick;
# see the PR body for the co-cached newest-across-flavors note).
flavors:
  temurin:
    implementation: "temurin"
    language_version: "21"           # the java language line (JAVA_VERSION's major)
    abi_line: "21"                   # the JVM's own line grammar; java has no native-ext ABI grammar
    interpreter_api_version: "21"    # layout.yaml's required declared line
    # The complete bin/ inventory of the staged JRE (spec 03 §2.2
    # completeness — verified against the staged tree 2026-08-30).
    entrypoints: [java, jfr, jrunscript, jwebserver, keytool, rmiregistry]
    upstream:
      # Eclipse Temurin JRE 21.0.12+8 (Adoptium) — one binary source per
      # platform (repack: no compilation). platform is the spec 03 triplet;
      # strip_components is the nesting depth of the payload root inside the
      # archive (macOS nests under <tag>/Contents/Home, windows under one dir).
      version: "21.0.12"
      build: "8"            # the Temurin build number (21.0.12+8)
      sources:
        - platform: "aarch64-macos"
          url: "https://github.com/adoptium/temurin21-binaries/releases/download/jdk-21.0.12%2B8/OpenJDK21U-jre_aarch64_mac_hotspot_21.0.12_8.tar.gz"
          sha256: "36bb71d6fa5184e12a6483e7662783c2cbd383f5dca8034140f0a84dd5aa797d"
          strip_components: 3
        - platform: "x86_64-windows-ucrt"
          url: "https://github.com/adoptium/temurin21-binaries/releases/download/jdk-21.0.12%2B8/OpenJDK21U-jre_x64_windows_hotspot_21.0.12_8.zip"
          sha256: "b8aa18fef5edb69bee8618f99677d66d0873d22cb40d974c15ac9ffcdecf73ba"
          strip_components: 1
        - platform: "x86_64-linux-gnu"
          url: "https://github.com/adoptium/temurin21-binaries/releases/download/jdk-21.0.12%2B8/OpenJDK21U-jre_x64_linux_hotspot_21.0.12_8.tar.gz"
          sha256: "8a379a67c91a3ae61ffb33d46e0a40c7ba35e70713c4db31cfca30492f792eff"
          strip_components: 1
  graalvm:
    implementation: "graalvm"
    language_version: "25"
    abi_line: "25"
    interpreter_api_version: "25"
    # The complete bin/ inventory of the staged GraalVM JDK (verified
    # against the staged macos tree 2026-09-06; a JDK, not a JRE — javac,
    # jlink and the native-image toolchain ride along; the spawn surface
    # still leads with java).
    entrypoints: [java, jar, jarsigner, javac, javadoc, javap, jcmd, jconsole, jdb, jdeprscan, jdeps, jfr, jhsdb, jimage, jinfo, jlink, jmap, jmod, jnativescan, jpackage, jps, jrunscript, jshell, jstack, jstat, jstatd, jwebserver, keytool, native-image, native-image-configure, native-image-utils, rmiregistry, serialver]
    # On windows the native-image family ships as .cmd launchers
    # (native-image.cmd etc. — verified against the upstream zip's bin/
    # 2026-09-06; every other declared name ships as .exe). Exec of a
    # .cmd through the runtime boot is untested, so the windows leg
    # declares the platform-true surface: the 30 .exe tools only.
    entrypoints_windows_drop: [native-image, native-image-configure, native-image-utils]
    upstream:
      # GraalVM Community 25.3.4.1 (JDK 25.0.4.1, graalvm-ce-builds) —
      # same repack pattern as temurin, one binary source per platform;
      # upstream publishes .sha256 sidecars (the pinned digests below,
      # fetched 2026-09-06). macOS nests <tag>/Contents/Home like temurin;
      # the windows source is a zip (bsdtar leg).
      version: "25.0.4.1"     # the JDK line (JAVA_VERSION)
      build: "25.3.4.1"       # the GraalVM release id (tag graal-25.3.4.1)
      sources:
        - platform: "aarch64-macos"
          url: "https://github.com/graalvm/graalvm-ce-builds/releases/download/graal-25.3.4.1/graalvm-community-jdk-25i3-25.0.4.1_macos-aarch64_bin.tar.gz"
          sha256: "ebfab1d74420f355a459076162012d6835fa6068bd9d2f230f1fcaf7ee0dd923"
          strip_components: 3
        - platform: "x86_64-windows-ucrt"
          url: "https://github.com/graalvm/graalvm-ce-builds/releases/download/graal-25.3.4.1/graalvm-community-jdk-25i3-25.0.4.1_windows-x64_bin.zip"
          sha256: "770a0d78aba4c19bd40ee410ec82afbbee8e33fdd762e509006ac64e1007b4ce"
          strip_components: 1
        - platform: "x86_64-linux-gnu"
          url: "https://github.com/graalvm/graalvm-ce-builds/releases/download/graal-25.3.4.1/graalvm-community-jdk-25i3-25.0.4.1_linux-x64_bin.tar.gz"
          sha256: "b2bc38d0c4141426eb44d0eefa3cc172c96faf92727d703b61541699128b6fc7"
          strip_components: 1

build:
  system: repack          # no compilation: unpack, prune, image
  deps: []

# The runtime contract (spec 28 revised §8 + spec 29). tools/build renders
# manifests/runtime.yaml (tier-1, embedded at /__tpkg__/manifest.yaml) and
# manifests/layout.yaml (the driver pair contract, /lib/tebako/layout.yaml)
# from this block + the selected flavor's block — the feedstock's SSOT for
# the pair's declared identity. The per-flavor keys (implementation,
# language_version, abi_line, interpreter_api_version, entrypoints) live
# under flavors:<flavor>; the keys here are shared by both flavors.
runtime:
  engine: "java"
  contract_version: 2              # the spec 17 driver contract the wrapper speaks
  interpreter: "/bin/java"         # the wrapper's interpreter grant (layout schema_minor 4)
  # The per-flavor entrypoints list (flavors:<flavor>.entrypoints) is the
  # feedstock SSOT for the spawn surface (spec 30 §2): tools/build renders
  # it into the env image manifest's runtime entrypoints, the driver's
  # bare-name --tebako-entry resolves against exactly these declarations,
  # and the read-back + smoke gates prove them.
  visibility: "exec-cache"         # spec 29 §3: a JVM needs no VFS once its home is materialized; universal across triplets
  mount_root_override: false       # closed default — nothing in the JVM follows TEBAKO_MOUNT_ROOT; granting a no-op knob violates spec 00 §9
  # The tebako product line the pair builds against: the wrapper exe
  # (tebako-runtime-launcher) and the preload shim (link-unit). The line
  # number names the artifacts (tebako-runtime-<line>-21.0.12-*) and the
  # release tag (v<line> — the trr convention: the tag IS the tebako
  # line; distinct from the toolkit-era payload tags like 21.0.12-2).
  #
  # v2.1.0 (2026-09-01) is the first product release shipping
  # tebako-runtime-launcher on all 7 platforms (tamatebako/tebako#498,
  # spec 30). The local dogfood built the wrapper from
  # tamatebako/tebako@d61ccc50 (workspace version 2.0.0).
  # v2.1.3 (2026-09-02, tebako#515): the wrapper's preload shim
  # interposes the realpath family + gates the vfork-child pid — the
  # linux-gnu jing ClassNotFound class (usrmerge /lib→usr/lib leak into
  # the JDK's -jar/-cp canonicalization).
  # v2.1.4 (2026-09-02, tebako#516): the realpath NULL-buffer arm's
  # host pass-through routes to canonicalize_file_name on linux —
  # plain dlsym lands on the realpath@GLIBC_2.0 compat twin on
  # glibc ≤ 2.31, which EINVALs the NULL arm and broke jailed spawns
  # (exit 78) on the 0.16.19 factory floor.
  # v2.1.5 (2026-09-02, tebako#517): the NULL-arm reroute is
  # glibc-scoped — musl has no canonicalize_file_name at all, so the
  # v2.1.4 musl unit's constructor panicked on the RTLD_NEXT lookup
  # (all 44 musl legs of the first 0.16.19 re-cut). musl keeps the
  # plain-dlsym arm (no symbol versioning → no compat twin).
  # v2.3.0 (2026-09-05, tebako#538): spec 29 (the runtime-as-wrapper
  # pattern this pair is built on) flips PLANNED → SHIPPED. No wrapper
  # code change — the pin moves to the first line where the contract
  # the pair speaks is a shipped contract, not a draft.
  # v2.4.0 (2026-09-06): REQUIRED, not hygiene. The launcher's embedded
  # tpkg model must read spec 32's `kind: executable` requires edge
  # (shipped in tebako v2.2.0): metanorma 1.16.9-9 declares that edge
  # (xml2rfc spawn) and the 2.3.0 launcher's manifest parse refuses it
  # by the evolution law ("Jing failed … unknown variant `executable`"
  # on the 2026-09-06 bench's v2-shim cells). 2.4.0 is the current line
  # (enterprise networking, TODO.v2-1/33).
  # v2.5.0 (2026-09-07): REQUIRED, not hygiene, for spec 33 — the
  # on_runtime composition (TODO.truffleruby/03 + TODO.jruby/02 make this
  # pair the OWNER of a composed process). Spec 33 §1 amends entry
  # resolution: --tebako-entry resolves against the first image mount
  # whose manifest is NOT the depending runtime's env image; the 2.4.0
  # launcher predates that rule and joins the entry onto the depending
  # runtime's mount (the local jvm-leg composed smoke: "entrypoint
  # '/app/bin/hello' not found at '/__runners__/truffleruby/app/bin/hello'"
  # — green only once the owner exe was the 2.5.0 launcher). BOTH flavors
  # reline: graalvm is truffleruby-jvm's owner edge, temurin is jruby's.
  # v2.7.0 (2026-09-12): REQUIRED reline. The v2.5.1 tag re-published the
  # 2.5.0 line with signing but left wrapper_tebako at 2.5.0 — breaking
  # this repo's own rule that the tag IS the line: composed-name fetches
  # (the spawned-runtime {base}/v<line>/<asset> path) 404'd on
  # tebako-runtime-2.5.1-* (metanorma 1.16.9-11 publish, run 34683540428).
  # The line moves to the current signed product release and the publish
  # gains a tag==line guard so the mismatch can never publish again.
  wrapper_tebako: "2.7.0"
  # The wrapper's trust anchor, per tool-platform (the launcher is the
  # shipped runtime pair's process entry point — an unauthenticated
  # download would be a supply-chain hole). Digests are the v2.7.0
  # release's monolith SHA256SUMS entries, fetched 2026-09-12.
  wrapper_sha256:
    macos-arm64: "550a8bd3a1b5e4830983fe34241384d58e3ddaef837b9a230704922ce1ca9b0e"
    linux-gnu-x86_64: "fd62baca534cfca007c6a253365bed3df954d42ce913cf3c6db1e6a62b2101a9"
    windows-ucrt64: "2f3981a319d6242af0c20cd767fd708b0fcf9accf605502f838b5678873c8883"

# Factory tools used by tools/build (the imager + the preload shim): the
# tfs CLI and the link-unit tarball from the tamatebako/tebako release.
# The asset digests are pinned HERE — tools.sha256 is the repo's
# toolchain pin SSOT (the workflow carries no version or digest literals;
# tools/pins.rb reads this block into $GITHUB_ENV). The tfs pins are
# cross-checked against the release's SHA256SUMS at fetch time; the
# link-unit tarballs are NOT in that monolith, so these pins are their
# single trust anchor (verified against the v2.7.0 downloads 2026-09-12).
tools:
  repo: "tamatebako/tebako"
  release: "v2.7.0"
  sha256:
    tfs:
      macos-arm64: "354939b1a6cad7d1112635726bba87dca2e419bcb3c38242f86bcdcdf4a77073"
      linux-gnu-x86_64: "ca96fa3f9789c1c7e22a1eb4cce28f38277c0822a001dbaaa8d432e1bf268f33"
      windows-ucrt64: "a30aa578c19b9babfeb24a7ff6fdbbc9f7fd8a1cff066d620645013c4c74d7bc"
    link-unit:                       # POSIX legs only; the windows image omits preload_shim
      macos-arm64: "0841d529237bf7920358f478621b89a73fad70bf46e0e78a4b5e8720a31ad0a4"
      linux-gnu-x86_64: "b0324d7f3d0fc0a9a72d23ce902cbcf5db14197464f10988f8c5fb2f1b263c72"

image:
  format: dwarfs
  # .tfs everywhere (the tebako fs image — DwarFS-T format; normal dwarfs
  # readers cannot read it)
  extension:
    default: tfs
