          sha256: "5f9c96b656827b9d14ebeda7739e25be554fa6d25669b03847c1df6e869c0679"
          strip_components: 1
        # The musl (alpine) pair — temurin only: graalvm-ce-builds
        # publishes NO musl assets (verified against graal-25.3.4.1's
